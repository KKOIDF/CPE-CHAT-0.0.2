@startuml Backend_C3_Ingestion_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - Ingestion Service Component Diagram

package "Ingestion Service" as ingestion_container {

    Component(main, "CLI Entry", "main.py", "Batch ingestion CLI\nDomain-aware orchestration")

    package "Extraction Layer" as extraction {
        Component(ocr_pipe, "OCR + Parsing", "ocr_pipeline.py", "ingest_pdf/ingest_excel/ingest_txt\nRecord extraction")
    }

    package "Processing Layer" as processing {
        Component(chunking, "Chunking Engine", "chunking.py", "Paragraph normalization\nDomain-specific chunk strategies")
        Component(quality_review, "OCR Quality Rules", "quality.py", "Score and flag low-quality OCR text")
    }

    package "Embedding Layer" as embedding {
        Component(chroma_client, "Embedding + Vector Index", "chroma_client.py", "BGE-M3 embeddings\nUpsert/query Chroma")
    }

    package "Storage Layer" as storage {
        Component(toon_conv, "TOON IO", "toon_converter.py\ntoon_format.py", "Serialize records/chunks to TOON")
        Component(db_client, "SQLite Writer", "db.py", "Persist chunks and quality logs")
        Component(graph_upsert, "Graph Upsert (Optional)", "neo4j_graph.py", "Curriculum graph projection to Neo4j")
    }

    Component(config, "Configuration", "config.py", "Load Settings\nModel Parameters")
}

Rel(main, config, "Loads")
Rel(main, ocr_pipe, "Routes")

Rel(ocr_pipe, chunking, "Text Output")

Rel(chunking, quality_review, "Quality check")
Rel(chunking, chroma_client, "Embed + index")
Rel(chunking, db_client, "Store metadata")
Rel(chunking, toon_conv, "Convert")
Rel(toon_conv, db_client, "Load/Save")
Rel(chunking, graph_upsert, "Upsert curriculum graph")

Rel(db_client, quality_review, "Persist quality records")

@enduml
