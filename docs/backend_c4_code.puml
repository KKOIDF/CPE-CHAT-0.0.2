@startuml C4_CodeLevel_Full_Styled
' -------------------------------------------------------
' Imports
' -------------------------------------------------------
!include <C4/C4_Deployment>

' -------------------------------------------------------
' Layout
' -------------------------------------------------------
left to right direction
LAYOUT_WITH_LEGEND()

' -------------------------------------------------------
' Package Styles
' -------------------------------------------------------
skinparam package {
  BackgroundColor #F7F9FF
  BorderColor #6A8DFF
  FontColor #1A1A1A
}

' -------------------------------------------------------
' Class Styles (Stereotypes)
' -------------------------------------------------------
skinparam class {
  BorderColor #444444
  FontColor #222222
    BackgroundColor<<Core>> #E1ECFF
  BackgroundColor<<Converter>> #F7E8FF
    BackgroundColor<<Decision>> #EBF2FF
    BackgroundColor<<Observability>> #F0FFF6
  BackgroundColor<<Data>> #FFFFFF
}

skinparam ArrowColor #333333
skinparam ArrowThickness 2

' -------------------------------------------------------
' Ingestion Service
' -------------------------------------------------------
package "Ingestion Service" #DDEBFF {
    class TOONEncoder <<Converter>> {
        - indent: str
        + encode(data): str
        + _encode_dict(data, level): str
    }

    class TOONDecoder <<Converter>> {
        + decode(toon_str): Dict|List
        + _parse_lines(lines, start_idx): tuple
        + _parse_value(value_str): Any
    }
}

' -------------------------------------------------------
' RAG Service
' -------------------------------------------------------
package "RAG Service" #DFFFE6 {

    class LLMEngine <<Core>> {
        - model_name: str
        - tokenizer: Any
        - model: Any
        + load(): void
        + generate(prompt): str
    }

    class RouteDecision <<Decision>> {
        - normalized_question: str
        - requested_domain: Optional[str]
        - inferred_domain: Optional[str]
        - effective_domain: Optional[str]
        - primary_intent: str
        - is_multi_intent: bool
        - subqueries: List[str]
        - structured_eligible: bool
        - structured_kind: str
        - requires_clause_anchor: bool
        - needs_exact_schema: bool
        - timeout_policy: str
        - fallback_policy: str
    }

    class ResolutionStrategy <<Decision>> {
        - resolution_path: str
    }

    class Course <<Data>> {
        - prefix: str
        - number: str
        - title_th: str
        - credits: int
        + code: str
    }

    class CurriculumCPE2564 <<Data>> {
        - source_path: Path
        - required_cpe_common: tuple[Course,...]
        - required_cpe_normal_only: tuple[Course,...]
        - required_cpe_wil_only: tuple[Course,...]
    }

    class PreparedChatRequest <<Data>> {
        - question: str
        - domain: Optional[str]
        - session_id: str
        - messages: List[Dict]
        - followup_meta: Dict
    }

    class InMemorySessionStore <<Core>> {
        + get_chat_history(session_id): List[str]
        + append_chat_turn(session_id, user_question): None
        + get_followup_hint(session_id): Dict|None
        + put_followup_hint(session_id, question, domain, intent): None
    }

    class RedisSessionStore <<Core>> {
        - redis_url: str
        - ttl_seconds: int
        + get_chat_history(session_id): List[str]
        + append_chat_turn(session_id, user_question): None
        + get_followup_hint(session_id): Dict|None
        + put_followup_hint(session_id, question, domain, intent): None
    }

    class MlflowObservability <<Observability>> {
        - _cfg: _Cfg
        - _run_id: Optional[str]
        + start(): None
        + stop(): None
        + flush(): None
    }
}

' -------------------------------------------------------
' Relationships (Improved labeling)
' -------------------------------------------------------

Rel(TOONEncoder, TOONDecoder, "paired serialization format")
Rel(RouteDecision, ResolutionStrategy, "drives")
Rel(CurriculumCPE2564, Course, "contains")
Rel(RedisSessionStore, InMemorySessionStore, "fallback to")
Rel(MlflowObservability, LLMEngine, "observes runtime behavior")

@enduml