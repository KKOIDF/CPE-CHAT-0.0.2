@startuml Backend_C1_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title C1 - CPE CHAT System Context Diagram

Person(user, "User", "End user using OpenWeb-UI")
System(cpe_system, "CPE CHAT System", "Domain-aware RAG system\nOpenWeb-UI + RAG Service + Ingestion")

Person(admin, "Operator", "Admin/Operator\nIngest + Evaluate")

System_Ext(external_docs, "Document Sources", "PDF/TXT/XLSX/CSV")
System_Ext(llm, "LLM Providers", "Ollama / Typhoon\nOpenAI-compatible API")
System_Ext(ocr, "OCR Engines (Optional)", "MuPDF/Tesseract\nor Typhoon OCR API")
System_Ext(neo4j, "Neo4j Graph DB (Optional)", "Curriculum graph RAG")

Rel(user, cpe_system, "Chats and asks questions")
Rel(admin, cpe_system, "Runs ingestion and evaluation")
Rel(cpe_system, external_docs, "Ingests documents")
Rel(cpe_system, llm, "Generates answers via")
Rel(cpe_system, ocr, "OCR for scanned PDFs")
Rel(cpe_system, neo4j, "Graph lookup (optional)")

@enduml
