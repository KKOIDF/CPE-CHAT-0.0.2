@startuml CPE_CHAT_UseCase
!theme plain
skinparam actorStyle awesome

title CPE CHAT System - Use Case Diagram

left to right direction

actor "End User" as user
actor "Operator" as ops

rectangle "CPE CHAT System" {
    usecase "Chat with RAG" as UC_Chat
    usecase "View Chat History" as UC_History
    usecase "Receive Cited Answer" as UC_Cited

    usecase "Run Ingestion Pipeline (Offline)" as UC_Ingest
    usecase "Build Indexes\n(Chroma + SQLite FTS)" as UC_Index
    usecase "Generate Structured Artifacts" as UC_Artifacts
    usecase "Upsert Curriculum Graph (Optional)" as UC_Graph

    usecase "Run Evaluation / Regression Gate" as UC_Eval
    usecase "Monitor MLflow (Optional)" as UC_MLflow

    UC_Chat ..> UC_Cited : <<include>>
    UC_Ingest ..> UC_Index : <<include>>
    UC_Ingest ..> UC_Artifacts : <<include>>
    UC_Ingest ..> UC_Graph : <<extend>>
}

user --> UC_Chat
user --> UC_History

ops --> UC_Ingest
ops --> UC_Eval
ops --> UC_MLflow

note bottom of UC_Ingest
  Input: PDF/TXT/XLSX/CSV
  Output: Chroma + SQLite indexes
end note

note right of UC_Cited
  Answers include inline citations
  and source/page references
end note

@enduml
