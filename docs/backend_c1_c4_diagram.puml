@startuml Backend_C1_C4_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

!define FONTNAME Arial
!define FONTCOLOR #333333
!define ARCCOLOR #438DD5

' ========================================
' C1: System Context Diagram
' ========================================
LAYOUT_WITH_LEGEND()

title C1 - CPE CHAT System Context Diagram

actor "User" as user
rectangle "CPE CHAT System\nfor Document Intelligence" as cpe_system

actor "Administrator" as admin

rectangle "External Document Sources\nPDF, Excel, Images" as external_docs
rectangle "LLM Service\n(Typhoon/OpenAI-compatible API)" as llm

Rel(user, cpe_system, "Uses")
Rel(admin, cpe_system, "Manages")
Rel(cpe_system, external_docs, "Ingests")
Rel(cpe_system, llm, "Queries")

@enduml

' ========================================
' C2: Container Diagram
' ========================================

@startuml Backend_C2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C2 - CPE CHAT Backend Container Architecture

note as c2_sot
Runtime Source of Truth: docker-compose.yml
If service names or runtime call flow change,
update this C2 diagram in the same PR.
end note

actor "User" as user
actor "Administrator" as admin

package "Client Layer" as client_boundary {
    rectangle "OpenWeb-UI\n[OpenWeb-UI]\nChat UI (OpenAI-compatible client)" as web_app
}

package "Backend Services" as backend_boundary {
    package "Ingestion Service" as ingestion_svc_boundary {
        rectangle "Ingestion Pipeline (Offline)\n[Python CLI]\nBatch ingest/index job" as ingestion_api
    }
    
    package "RAG Service" as rag_svc_boundary {
        rectangle "RAG Query Engine\n[Python/FastAPI]\nOpenAI-compatible /v1 API\nRetrieval + Generation" as rag_api
    }

    rectangle "MLflow\n[Tracking/Observability]\nExperiment tracking and request telemetry" as mlflow
}

package "Data Layer" as data_boundary {
    database "Vector Database\n[Chroma]\nEmbeddings & Chunks" as vector_db
    database "SQL Database\n[SQLite/Postgres]\nRecords & Sessions" as sql_db
    database "File Storage\n[Local/Cloud]\nOriginal & Processed Files" as file_storage
}

rectangle "LLM Provider\nTyphoon/OpenAI-compatible API" as external_llm
rectangle "OCR Service\nTyphoon OCR / Google Vision" as external_ocr

Rel(user, web_app, "Uses", "HTTP/WebSocket")
Rel(admin, web_app, "Uses", "HTTP/WebSocket")

Rel(web_app, rag_api, "Calls", "HTTP/REST (OpenAI-compatible /v1)")

Rel(ingestion_api, vector_db, "Stores Embeddings")
Rel(ingestion_api, sql_db, "Stores Metadata")
Rel(ingestion_api, file_storage, "Stores Documents")
Rel(ingestion_api, external_ocr, "OCR Processing")

Rel(rag_api, vector_db, "Queries Embeddings")
Rel(rag_api, sql_db, "Queries Metadata")
Rel(rag_api, external_llm, "Generates Responses")
Rel(rag_api, mlflow, "Logs traces and metrics")

@enduml

' ========================================
' C3: Component Diagram - Ingestion Service
' ========================================

@startuml Backend_C3_Ingestion_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - Ingestion Service Components

package "Ingestion Service" as ingestion_container {
    Component(ingestion_main, "CLI Entry Point", "main.py", "Batch ingestion CLI\nDomain-aware orchestration")

    Component(ocr_pipeline, "OCR Pipeline", "ocr_pipeline.py", "ingest_pdf/ingest_excel/ingest_txt\nRecord extraction")
    Component(chunking, "Chunking Engine", "chunking.py", "Paragraph normalization\nDomain-specific chunk strategies")
    Component(quality, "OCR Quality Rules", "quality.py", "Score and flag low-quality OCR text")

    Component(db_client, "SQLite Writer", "db.py", "Persist chunks and quality logs")
    Component(chroma_client, "Embedding + Vector Index", "chroma_client.py", "BGE-M3 embeddings\nUpsert/query Chroma")
    Component(graph_writer, "Graph Upsert (Optional)", "neo4j_graph.py", "Curriculum graph projection to Neo4j")

    Component(toon_converter, "TOON IO", "toon_converter.py\ntoon_format.py", "Serialize records/chunks to TOON")
    Component(config, "Configuration", "config.py", "Environment settings\nModel parameters")
}

Rel(ingestion_main, ocr_pipeline, "Uses")
Rel(ingestion_main, config, "Reads")

Rel(ocr_pipeline, chunking, "Sends Text")
Rel(chunking, quality, "Checks OCR quality")
Rel(chunking, db_client, "Stores chunk metadata")
Rel(chunking, chroma_client, "Embeds + indexes")

Rel(chunking, toon_converter, "Converts")
Rel(toon_converter, db_client, "Loads/Saves")
Rel(chunking, graph_writer, "Upserts curriculum graph")
Rel(db_client, quality, "Persists quality records")

@enduml

' ========================================
' C3: Component Diagram - RAG Service
' ========================================

@startuml Backend_C3_RAG_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - RAG Service Components

package "RAG Service" as rag_container {
    Component(rag_main, "FastAPI Entry Point", "main.py", "Endpoints: /rag/* and /v1/*\nOpenAI-compatible chat completions")

    Component(orchestration, "Orchestration", "orchestration.py", "rag_query/ rag_query_domain\nStructured + generative path selection")
    Component(routing, "Routing and Intent", "routing.py", "classify_intent\ninfer_domain\nselect_resolution_strategy")
    Component(retrieval, "Retrieval Engine", "retrieval.py", "Hybrid retrieval\nRRF fusion\ncontext packing")
    Component(langchain_flow, "LangChain Path (Optional)", "langchain_rag.py", "Multi-query/re-rank/compression path")

    Component(chroma_rag, "Vector Search", "chroma_client.py", "Semantic similarity search")
    Component(metadata_engine, "SQLite Metadata", "sqlite_client.py", "Keyword search + doc metadata")
    Component(graph_lookup, "Graph Retrieval (Optional)", "neo4j_client.py", "Neo4j connection and graph lookups")

    Component(prompt_builder, "Prompt Builder", "prompting.py + retrieval.py", "Build prompts from packed context and citations")
    Component(llm_interface, "LLM Engine", "llm.py", "Typhoon/OpenAI/HF runtime\nStreaming + timeout handling")
    Component(observability, "Observability", "mlflow_observability.py", "MLflow request logs\nmetrics and traces")

    Component(config_rag, "Configuration", "config.py", "Model settings\nRetrieval parameters")
}

Rel(rag_main, orchestration, "Routes request")
Rel(rag_main, config_rag, "Reads")
Rel(rag_main, observability, "Publishes metrics")

Rel(orchestration, routing, "Analyzes intent/domain")
Rel(orchestration, retrieval, "Fetches contexts")
Rel(orchestration, prompt_builder, "Builds final prompt")
Rel(orchestration, llm_interface, "Calls model")
Rel(orchestration, langchain_flow, "Optional execution path")

Rel(retrieval, chroma_rag, "Vector search")
Rel(retrieval, metadata_engine, "Keyword/metadata search")
Rel(retrieval, graph_lookup, "Optional graph evidence")
Rel(retrieval, prompt_builder, "Provides packed context")

Rel(prompt_builder, llm_interface, "Prompt payload")

@enduml

' ========================================
' C4: Code Level - Key Classes
' ========================================

@startuml Backend_C4_Code_Classes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title C4 - Key Classes & Data Models

package "Ingestion Service Classes" {
    class TOONEncoder {
        - indent: str
        + encode(data): str
        + _encode_dict(data, level): str
    }

    class TOONDecoder {
        + decode(toon_str): Dict|List
        + _parse_lines(lines, start_idx): tuple
        + _parse_value(value_str): Any
    }
}

package "RAG Service Classes" {
    class LLMEngine {
        - model_name: str
        - tokenizer: Any
        - model: Any
        + load(): void
        + generate(prompt): str
    }

    class RouteDecision {
        - normalized_question: str
        - inferred_domain: Optional[str]
        - primary_intent: str
        - subqueries: List[str]
        - structured_eligible: bool
    }

    class ResolutionStrategy {
        - resolution_path: str
    }

    class Course {
        - prefix: str
        - number: str
        - title_th: str
        - credits: int
        + code: str
    }

    class CurriculumCPE2564 {
        - source_path: Path
        - required_cpe_common: tuple[Course,...]
        - required_cpe_normal_only: tuple[Course,...]
        - required_cpe_wil_only: tuple[Course,...]
    }

    class MlflowObservability {
        - _cfg: _Cfg
        - _run_id: Optional[str]
        + start(): None
        + stop(): None
        + flush(): None
    }
}

Rel(TOONEncoder, TOONDecoder, "paired serialization format")

Rel(RouteDecision, ResolutionStrategy, "drives")
Rel(CurriculumCPE2564, Course, "contains")
Rel(MlflowObservability, LLMEngine, "observes runtime behavior")

@enduml
