@startuml Backend_C1_C4_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

!define FONTNAME Arial
!define FONTCOLOR #333333
!define ARCCOLOR #438DD5

' ========================================
' C1: System Context Diagram
' ========================================
LAYOUT_WITH_LEGEND()

title C1 - CPE CHAT System Context Diagram

actor "User" as user
rectangle "CPE CHAT System\nDomain-aware RAG system" as cpe_system

actor "Operator" as admin

rectangle "Document Sources\nPDF/TXT/XLSX/CSV" as external_docs
rectangle "LLM Providers\nOllama / Typhoon\nOpenAI-compatible API" as llm
rectangle "OCR Engines (Optional)\nMuPDF/Tesseract\nor Typhoon OCR API" as ocr
rectangle "Neo4j Graph DB (Optional)\nCurriculum graph RAG" as neo4j

Rel(user, cpe_system, "Chats and asks questions")
Rel(admin, cpe_system, "Runs ingestion and evaluation")
Rel(cpe_system, external_docs, "Ingests")
Rel(cpe_system, llm, "Generates answers via")
Rel(cpe_system, ocr, "OCR for scanned PDFs")
Rel(cpe_system, neo4j, "Graph lookup (optional)")

@enduml

' ========================================
' C2: Container Diagram
' ========================================

@startuml Backend_C2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C2 - CPE CHAT Backend Container Architecture

note as c2_sot
Runtime Source of Truth: docker-compose.yml
If service names or runtime call flow change,
update this C2 diagram in the same PR.
end note

actor "User" as user
actor "Operator" as admin

package "Client Layer" as client_boundary {
    rectangle "OpenWeb-UI\n[OpenWeb-UI]\nChat UI (OpenAI-compatible client)" as web_app
}

package "Backend Services" as backend_boundary {
    rectangle "RAG Service\n[Python/FastAPI]\nOpenAI-compatible /v1 API\nRetrieval + Generation" as rag_api
    rectangle "Ingestion Pipeline (Offline)\n[Python CLI]\nBatch ingest/index job\nscripts/ingest_*.sh" as ingestion_api
    rectangle "MLflow (Optional)\n[Tracking/Observability]\nTracing + metrics" as mlflow
}

package "Data Layer" as data_boundary {
    database "Vector Index\n[Chroma]\nEmbeddings per domain" as vector_db
    database "Keyword Index\n[SQLite FTS]\nChunks + metadata" as sqlite_db
    database "Structured Artifacts\n[JSON files]\nAnnouncement calendar\nPrerequisites/clauses" as structured_store
    database "Raw/Processed Files\n[Local volume]\nPDF/TXT/XLSX + TOON outputs" as file_storage
    database "Session Store\n[Redis]\nChat follow-up memory (TTL)" as session_store
}

rectangle "LLM Providers\nOllama / Typhoon\nOpenAI-compatible API" as external_llm
rectangle "OCR Engines (Optional)\nMuPDF/Tesseract\nor Typhoon OCR API" as external_ocr
rectangle "Neo4j Graph DB (Optional)\nCurriculum graph RAG" as neo4j

Rel(user, web_app, "Uses", "HTTP/WebSocket")
Rel(admin, web_app, "Uses", "HTTP/WebSocket")
Rel(admin, ingestion_api, "Runs", "CLI/Batch")

Rel(web_app, rag_api, "Calls", "HTTP/REST (/v1)")

Rel(ingestion_api, vector_db, "Stores embeddings")
Rel(ingestion_api, sqlite_db, "Stores chunks + metadata")
Rel(ingestion_api, structured_store, "Writes artifacts")
Rel(ingestion_api, file_storage, "Reads/writes documents")
Rel(ingestion_api, external_ocr, "OCR processing")
Rel(ingestion_api, neo4j, "Graph upsert (optional)")

Rel(rag_api, vector_db, "Semantic search")
Rel(rag_api, sqlite_db, "Keyword search")
Rel(rag_api, structured_store, "Reads artifacts")
Rel(rag_api, session_store, "Follow-up memory")
Rel(rag_api, external_llm, "Generate responses")
Rel(rag_api, neo4j, "Graph retrieval (optional)")
Rel(rag_api, mlflow, "Logs traces/metrics")

@enduml

