' ========================================
' C4: Code Level - Key Classes
' ========================================

@startuml Backend_C4_Code_Classes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title C4 - Key Classes & Data Models

package "Ingestion Service Classes" {
    class TOONEncoder {
        - indent: str
        + encode(data): str
        + _encode_dict(data, level): str
    }

    class TOONDecoder {
        + decode(toon_str): Dict|List
        + _parse_lines(lines, start_idx): tuple
        + _parse_value(value_str): Any
    }
}

package "RAG Service Classes" {
    class LLMEngine {
        - model_name: str
        - tokenizer: Any
        - model: Any
        + load(): void
        + generate(prompt): str
    }

    class RouteDecision {
        - normalized_question: str
        - requested_domain: Optional[str]
        - inferred_domain: Optional[str]
        - effective_domain: Optional[str]
        - primary_intent: str
        - is_multi_intent: bool
        - subqueries: List[str]
        - structured_eligible: bool
        - structured_kind: str
        - requires_clause_anchor: bool
        - needs_exact_schema: bool
        - timeout_policy: str
        - fallback_policy: str
    }

    class ResolutionStrategy {
        - resolution_path: str
    }

    class Course {
        - prefix: str
        - number: str
        - title_th: str
        - credits: int
        + code: str
    }

    class CurriculumCPE2564 {
        - source_path: Path
        - required_cpe_common: tuple[Course,...]
        - required_cpe_normal_only: tuple[Course,...]
        - required_cpe_wil_only: tuple[Course,...]
    }

    class PreparedChatRequest {
        - question: str
        - domain: Optional[str]
        - session_id: str
        - messages: List[Dict]
        - followup_meta: Dict
    }

    class InMemorySessionStore {
        + get_chat_history(session_id): List[str]
        + append_chat_turn(session_id, user_question): None
        + get_followup_hint(session_id): Dict|None
        + put_followup_hint(session_id, question, domain, intent): None
    }

    class RedisSessionStore {
        - redis_url: str
        - ttl_seconds: int
        + get_chat_history(session_id): List[str]
        + append_chat_turn(session_id, user_question): None
        + get_followup_hint(session_id): Dict|None
        + put_followup_hint(session_id, question, domain, intent): None
    }

    class MlflowObservability {
        - _cfg: _Cfg
        - _run_id: Optional[str]
        + start(): None
        + stop(): None
        + flush(): None
    }
}

Rel(TOONEncoder, TOONDecoder, "paired serialization format")

Rel(RouteDecision, ResolutionStrategy, "drives")
Rel(CurriculumCPE2564, Course, "contains")
Rel(RedisSessionStore, InMemorySessionStore, "fallback to")
Rel(MlflowObservability, LLMEngine, "observes runtime behavior")

@enduml
