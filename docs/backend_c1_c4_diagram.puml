@startuml Backend_C1_C4_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Code.puml

!define FONTNAME Arial
!define FONTCOLOR #333333
!define ARCCOLOR #438DD5

' ========================================
' C1: System Context Diagram
' ========================================
LAYOUT_WITH_LEGEND()

title C1 - CPE CHAT System Context Diagram

actor "User" as user
rectangle "CPE CHAT System\nfor Document Intelligence" as cpe_system

actor "Administrator" as admin

rectangle "External Document Sources\nPDF, Excel, Images" as external_docs
rectangle "LLM Service\n(Claude, GPT, etc.)" as llm

Rel(user, cpe_system, "Uses")
Rel(admin, cpe_system, "Manages")
Rel(cpe_system, external_docs, "Ingests")
Rel(cpe_system, llm, "Queries")

@enduml

' ========================================
' C2: Container Diagram
' ========================================

@startuml Backend_C2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C2 - CPE CHAT Backend Container Architecture

actor "User" as user
actor "Administrator" as admin

package "Client Layer" as client_boundary {
    rectangle "Web Application\n[React/Vite]\nFrontend UI for Chat & Document Management" as web_app
}

package "Backend Services" as backend_boundary {
    rectangle "API Gateway & Server\n[Node.js/Express]\nREST API / Routing / Auth" as api_server
    
    package "Ingestion Service" as ingestion_svc_boundary {
        rectangle "Ingestion API\n[Python/FastAPI]\nUploads, PDF/Excel/Image processing" as ingestion_api
    }
    
    package "RAG Service" as rag_svc_boundary {
        rectangle "RAG Query Engine\n[Python/FastAPI]\nQuery, Retrieve, Generate" as rag_api
    }
}

package "Data Layer" as data_boundary {
    database "Vector Database\n[Chroma]\nEmbeddings & Chunks" as vector_db
    database "SQL Database\n[SQLite/Postgres]\nRecords & Sessions" as sql_db
    database "File Storage\n[Local/Cloud]\nOriginal & Processed Files" as file_storage
}

rectangle "LLM Provider\nClaude/GPT/Typhoon" as external_llm
rectangle "OCR Service\nTyphoon OCR / Google Vision" as external_ocr

Rel(user, web_app, "Uses", "HTTP/WebSocket")
Rel(admin, web_app, "Uses", "HTTP/WebSocket")

Rel(web_app, api_server, "Calls", "HTTP/REST")
Rel(api_server, ingestion_api, "Routes", "HTTP/gRPC")
Rel(api_server, rag_api, "Routes", "HTTP/gRPC")

Rel(ingestion_api, vector_db, "Stores Embeddings")
Rel(ingestion_api, sql_db, "Stores Metadata")
Rel(ingestion_api, file_storage, "Stores Documents")
Rel(ingestion_api, external_ocr, "OCR Processing")

Rel(rag_api, vector_db, "Queries Embeddings")
Rel(rag_api, sql_db, "Queries Metadata")
Rel(rag_api, external_llm, "Generates Responses")

@enduml

' ========================================
' C3: Component Diagram - Ingestion Service
' ========================================

@startuml Backend_C3_Ingestion_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - Ingestion Service Components

package "Ingestion Service" as ingestion_container {
    Component(ingestion_main, "Main Entry Point", "main.py", "FastAPI App\nRequest routing")
    
    Component(pdf_extractor, "PDF Extractor", "extract_pdf.py", "Extract text from PDF\nHandle scanned images")
    Component(excel_extractor, "Excel Extractor", "extract_excel.py", "Parse Excel files\nExtract tables & data")
    Component(ocr_pipeline, "OCR Pipeline", "ocr_pipeline.py", "Process scanned documents\nIntegrate with Typhoon OCR")
    
    Component(chunking, "Text Chunking", "chunking.py", "Split documents into chunks\nMaintain context")
    Component(thai_nlp, "Thai NLP", "thai_nlp.py", "Thai language processing\nTokenization")
    Component(validation, "Data Validation", "validation.py", "Validate document quality\nCheck completeness")
    
    Component(embedding, "Embedding Service", "Uses BGE-M3", "Generate vector embeddings\nMultilingual support")
    Component(chroma_client, "Chroma Client", "chroma_client.py", "Vector DB interface\nStore/retrieve embeddings")
    
    Component(toon_converter, "TOON Converter", "toon_converter.py\ntoon_format.py", "Convert data to TOON format\nCompression & serialization")
    Component(db_client, "Database Client", "db.py", "SQLite/Postgres access\nStore metadata & records")
    
    Component(quality, "Quality Check", "quality.py", "Review flagged items\nData quality assurance")
    Component(config, "Configuration", "config.py", "Environment settings\nModel parameters")
}

Rel(ingestion_main, pdf_extractor, "Uses")
Rel(ingestion_main, excel_extractor, "Uses")
Rel(ingestion_main, ocr_pipeline, "Uses")
Rel(ingestion_main, config, "Reads")

Rel(pdf_extractor, chunking, "Sends Text")
Rel(excel_extractor, chunking, "Sends Data")
Rel(ocr_pipeline, chunking, "Sends Text")

Rel(chunking, thai_nlp, "Processes")
Rel(chunking, validation, "Validates")

Rel(validation, embedding, "Sends Chunks")
Rel(embedding, chroma_client, "Stores")

Rel(chunking, toon_converter, "Converts")
Rel(toon_converter, db_client, "Stores")
Rel(db_client, quality, "Records for Review")

@enduml

' ========================================
' C3: Component Diagram - RAG Service
' ========================================

@startuml Backend_C3_RAG_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - RAG Service Components

package "RAG Service" as rag_container {
    Component(rag_main, "Main Entry Point", "main.py", "FastAPI App\nRequest routing")
    
    Component(query_processor, "Query Processor", "rag_logic.py", "Parse user queries\nPrepare for search")
    Component(retriever, "Retriever", "Chroma Interface", "Semantic search\nRetrieve relevant chunks")
    
    Component(chroma_rag, "Chroma Client", "chroma_client.py", "Vector DB queries\nEmbedding similarity search")
    Component(metadata_engine, "Metadata Engine", "sqlite_client.py", "Query document metadata\nFilter results")
    
    Component(llm_interface, "LLM Interface", "llm.py", "Call LLM API\nPrompt engineering")
    Component(prompt_builder, "Prompt Builder", "rag_logic.py", "Construct prompts\nAdd context & chunks")
    
    Component(response_generator, "Response Generator", "rag_logic.py", "Format LLM responses\nAdd citations")
    Component(cache_manager, "Cache Manager", "Optional Caching", "Cache frequent queries\nReduce API calls")
    
    Component(config_rag, "Configuration", "config.py", "Model settings\nRetrieval parameters")
}

Rel(rag_main, query_processor, "Uses")
Rel(query_processor, retriever, "Sends Query")
Rel(retriever, chroma_rag, "Searches")
Rel(retriever, metadata_engine, "Queries")

Rel(query_processor, prompt_builder, "Prepares")
Rel(prompt_builder, llm_interface, "Calls")
Rel(retriever, prompt_builder, "Provides Context")

Rel(llm_interface, cache_manager, "Checks/Updates Cache")
Rel(llm_interface, response_generator, "Returns Response")

Rel(rag_main, config_rag, "Reads")

@enduml

' ========================================
' C4: Code Level - Key Classes
' ========================================

@startuml Backend_C4_Code_Classes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Code.puml

LAYOUT_WITH_LEGEND()

title C4 - Key Classes & Data Models

package "Ingestion Service Classes" {
    class PDFExtractor {
        - file_path: str
        - use_ocr: bool
        + extract_text(): str
        + extract_images(): List[Image]
    }
    
    class TextChunker {
        - chunk_size: int
        - overlap: int
        + chunk_text(): List[Chunk]
        + preserve_context(): Chunk
    }
    
    class ChromaClient {
        - collection_name: str
        + add_embeddings(): bool
        + search(): List[Result]
    }
    
    class TOONConverter {
        - compression_level: int
        + to_toon(): bytes
        + from_toon(): dict
    }
    
    class Document {
        - doc_id: str
        - content: str
        - metadata: dict
        - chunks: List[Chunk]
        - created_at: datetime
    }
}

package "RAG Service Classes" {
    class RAGEngine {
        - retriever: Retriever
        - llm: LLMClient
        + query(): str
        + generate_response(): str
    }
    
    class Retriever {
        - vector_db: ChromaClient
        - metadata_db: SQLiteClient
        + retrieve_chunks(): List[Chunk]
        + filter_by_metadata(): List[Chunk]
    }
    
    class LLMClient {
        - model_name: str
        - api_key: str
        + call_model(): str
        + stream_response(): Iterator[str]
    }
    
    class PromptTemplate {
        - system_prompt: str
        - context_template: str
        + build_prompt(): str
    }
    
    class RAGResponse {
        - query: str
        - response: str
        - sources: List[Source]
        - confidence: float
    }
}

Rel(PDFExtractor, TextChunker, "produces Chunks")
Rel(TextChunker, ChromaClient, "sends to")
Rel(TextChunker, TOONConverter, "converts")

Rel(RAGEngine, Retriever, "uses")
Rel(RAGEngine, LLMClient, "calls")
Rel(Retriever, ChromaClient, "queries")
Rel(LLMClient, PromptTemplate, "uses")
Rel(RAGEngine, RAGResponse, "produces")

@enduml
