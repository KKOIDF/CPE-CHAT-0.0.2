@startuml Backend_C2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C2 - CPE CHAT Backend Container Architecture

note as c2_sot
Runtime Source of Truth: docker-compose.yml
If service names or runtime call flow change,
update this C2 diagram in the same PR.
end note

Person(user, "User", "Client/Browser")
Person(admin, "Administrator", "Admin User")

Container_Boundary(client_boundary, "Client Layer") {
    Container(web_app, "OpenWeb-UI", "OpenWeb-UI", "Chat UI\nOpenAI-compatible client")
}

Container_Boundary(backend_boundary, "Backend Services") {
    Container(rag_api, "RAG Service", "Python/FastAPI", "OpenAI-compatible /v1 API\nRetrieval + Generation")
    Container(ingestion_job, "Ingestion Pipeline (Offline)", "Python CLI", "Batch ingest/index job\nNot deployed in current docker-compose")
    Container(mlflow, "MLflow", "Tracking Server", "Observability\nExperiment tracking")
}

Container_Boundary(data_boundary, "Data Layer") {
    ContainerDb(vector_db, "Vector Database", "Chroma", "Document Embeddings\nSemantic Search Index")
    
    ContainerDb(sql_db, "Relational Database", "SQLite/PostgreSQL", "Document Metadata\nUser Sessions\nProcessing Records")
    
    ContainerDb(file_storage, "File Storage", "Local/Cloud", "Original Documents\nProcessed Files")
}

System_Ext(external_llm, "LLM Provider", "Typhoon/OpenAI-compatible\nAPI Service")

System_Ext(external_ocr, "OCR Service", "Typhoon OCR\nGoogle Vision API")

Rel(user, web_app, "Uses", "HTTP/WebSocket")
Rel(admin, web_app, "Manages", "HTTP/WebSocket")

Rel(web_app, rag_api, "Calls API", "HTTP/REST (/v1)")

Rel(ingestion_job, vector_db, "Stores Embeddings")
Rel(ingestion_job, sql_db, "Stores Metadata")
Rel(ingestion_job, file_storage, "Reads/Writes Documents")
Rel(ingestion_job, external_ocr, "OCR Processing")
Rel(admin, ingestion_job, "Runs/controls", "CLI/Batch")

Rel(rag_api, vector_db, "Semantic Search")
Rel(rag_api, sql_db, "Query Metadata")
Rel(rag_api, external_llm, "Generate Responses")
Rel(rag_api, mlflow, "Logs traces/metrics")

@enduml
