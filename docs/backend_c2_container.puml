@startuml Backend_C2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C2 - CPE CHAT Backend Container Architecture

Person(user, "User", "Client/Browser")
Person(admin, "Administrator", "Admin User")

Container_Boundary(client_boundary, "Client Layer") {
    Container(web_app, "Web Application", "React/Vite", "Frontend UI\nChat Interface\nDocument Management")
}

Container_Boundary(backend_boundary, "Backend Services") {
    Container(api_server, "API Gateway", "Node.js/Express", "REST API\nRequest Routing\nAuthentication")
    
    Container(ingestion_api, "Ingestion Service", "Python/FastAPI", "Document Upload\nPDF/Excel/Image Processing\nOCR Pipeline")
    
    Container(rag_api, "RAG Service", "Python/FastAPI", "Query Processing\nSemantic Search\nLLM Integration")
}

Container_Boundary(data_boundary, "Data Layer") {
    ContainerDb(vector_db, "Vector Database", "Chroma", "Document Embeddings\nSemantic Search Index")
    
    ContainerDb(sql_db, "Relational Database", "SQLite/PostgreSQL", "Document Metadata\nUser Sessions\nProcessing Records")
    
    ContainerDb(file_storage, "File Storage", "Local/Cloud", "Original Documents\nProcessed Files")
}

System_Ext(external_llm, "LLM Provider", "Claude/GPT/Typhoon\nAPI Service")

System_Ext(external_ocr, "OCR Service", "Typhoon OCR\nGoogle Vision API")

Rel(user, web_app, "Uses", "HTTP/WebSocket")
Rel(admin, web_app, "Manages", "HTTP/WebSocket")

Rel(web_app, api_server, "Calls API", "HTTP/REST")

Rel(api_server, ingestion_api, "Routes Requests", "HTTP/gRPC")
Rel(api_server, rag_api, "Routes Requests", "HTTP/gRPC")

Rel(ingestion_api, vector_db, "Stores Embeddings")
Rel(ingestion_api, sql_db, "Stores Metadata")
Rel(ingestion_api, file_storage, "Archives Documents")
Rel(ingestion_api, external_ocr, "OCR Processing")

Rel(rag_api, vector_db, "Semantic Search")
Rel(rag_api, sql_db, "Query Metadata")
Rel(rag_api, external_llm, "Generate Responses")

@enduml
