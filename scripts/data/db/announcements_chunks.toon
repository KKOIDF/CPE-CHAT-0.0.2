  effective_from: ศ. 2562" **ข้อ 2** ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศเป็นต้นไป **ข้อ 3** ให้ยกเลิกประกาศมหาวิทยาลัยเทคโนโลยีพระจอมเ
  audience: 
  source: tetet2562doctor.txt
  path: "C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\tetet2562doctor.txt"
  page: 1
