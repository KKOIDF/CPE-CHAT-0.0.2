# ==============================================================
# CPE-CHAT Environment Example
# ==============================================================
# Copy this file to .env and fill in real values.
# NOTE: Do NOT commit your real .env (it may contain secrets).

# ------------------------------
# Ports
# ------------------------------
RAG_PORT=8001
OPENWEB_UI_PORT=3000
# Optional: used by docker-compose CORS_ORIGINS
OPENWEB_UI_URL=http://localhost:3000

# ------------------------------
# LLM Provider
# ------------------------------
# Supported: typhoon, ollama, openai
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:26b

# Optional secondary/auxiliary model used only as a fallback answer model.
LLM_AUX_PROVIDER=typhoon
LLM_AUX_MODEL=typhoon-v2.5-30b-a3b-instruct
LLM_AUX_FOR_REWRITE=0
LLM_AUX_FOR_MULTIQUERY=0
LLM_AUX_FOR_ROUTING=0
LLM_AUX_FALLBACK_FOR_ANSWER=1

# Typhoon LLM
# ------------------------------
# Required when LLM_AUX_PROVIDER=typhoon or LLM_PROVIDER=typhoon
TYPHOON_API_KEY=your_typhoon_api_key_here
# Optional
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1

# Ollama LLM
# ------------------------------
# Recommended for local/cluster inference via Ollama
# Example provided by the team:
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:26b
# OLLAMA_BASE_URL=http://gpu06.slurm.cpe.kmutt.ac.th:11434
# OLLAMA_API_KEY=sk-ollama-dummy
#
# Recommended dual-model setup:
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:26b
# LLM_AUX_PROVIDER=typhoon
# LLM_AUX_MODEL=typhoon-v2.5-30b-a3b-instruct
# OLLAMA_BASE_URL=http://gpu06.slurm.cpe.kmutt.ac.th:11434
# OLLAMA_API_KEY=sk-ollama-dummy
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_S=120
OLLAMA_THINK=0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FIRST_TOKEN_TIMEOUT_S=5
OLLAMA_OVERALL_TIMEOUT_S=45

# ------------------------------
# RAG / Debug
# ------------------------------
RAG_EXPOSE_CONFIG=0
RAG_RESPONSE_PROFILE=fast
RAG_FAST_MAX_CONTEXTS=8
TOKEN_BUDGET=2400
MAX_CONTEXTS=8

# Bigger chunking defaults for re-ingestion. Domain-specific overrides are
# read by ingestion-service when CPE_DOMAIN is set.
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=1100
CHUNK_OVERLAP_RATIO=0.18
REGULATIONS_CHUNK_MIN_TOKENS=250
REGULATIONS_CHUNK_MAX_TOKENS=850
REGULATIONS_CHUNK_OVERLAP_RATIO=0.15
ANNOUNCEMENTS_CHUNK_MIN_TOKENS=220
ANNOUNCEMENTS_CHUNK_MAX_TOKENS=700
ANNOUNCEMENTS_CHUNK_OVERLAP_RATIO=0.15

# Retrieval breadth
RAG_SEARCH_ALL_DOMAINS=0

# Curriculum is retrieval-first by default; exact deterministic guards still
# run for factual lookups selected by routing.
RAG_CURRICULUM_BYPASS_VECTOR=0

# Retrieval mode
# 0 = hybrid (vector + keyword) (recommended default)
# 1 = vector-only (use only for benchmarking)
RAG_VECTOR_ONLY=0

# Retrieval parallelism (built-in hybrid retrieval path)
RAG_RETRIEVAL_PARALLEL=1
RAG_RETRIEVAL_PARALLEL_WORKERS=2

# Retrieval debugging (logs queries/anchors/top sources)
RAG_DEBUG_RETRIEVAL=0

# Hybrid fusion tuning (weighted RRF)
RAG_HYBRID_SEMANTIC_WEIGHT=1.0
RAG_HYBRID_KEYWORD_WEIGHT=1.2

# Exact-anchor promotion tuning
RAG_DOMAIN_PRIOR_BONUS=0.15
RAG_ANCHOR_HIT_BONUS=0.18
RAG_MAX_PER_SOURCE=2

# ------------------------------
# Multi-document retrieval (multi-hop / multi-source)
# ------------------------------
# auto = enable only for multi-clause questions
# on   = force for all questions
# off  = disable (use single-doc pipeline)
RAG_MULTI_DOC_MODE=auto

# Add extra answer-guidance when contexts are grouped by source
RAG_MULTI_DOC_HINTS=1

# Decomposition + retrieval breadth
RAG_MULTI_DOC_MAX_SUBQS=3
RAG_MULTI_DOC_WIDE_LIMIT=24
RAG_MULTI_DOC_PER_DOMAIN_LIMIT=18

# Doc→chunk selection (helps ensure multiple documents appear)
RAG_MULTI_DOC_DOC_TOPN=6
RAG_MULTI_DOC_CHUNKS_PER_DOC=3

# Final evidence diversity constraints
RAG_MULTI_DOC_FINAL_LIMIT=8
RAG_MULTI_DOC_MAX_PER_SOURCE=2
RAG_MULTI_DOC_MIN_SOURCES=2

# LangChain presets
# Quality mode (more accurate, slower) - default
RAG_USE_LANGCHAIN=1
RAG_LC_MULTIQUERY=1
RAG_LC_MULTIQUERY_N=4
RAG_LC_MULTIQUERY_ALL=0
# Skip multi-query for anchored questions (course code / clause) to cut tail latency.
RAG_LC_MULTIQUERY_FOR_ANCHORED=0
RAG_LC_PARALLEL=1
RAG_LC_PARALLEL_WORKERS=4
RAG_LC_RERANK=1
RAG_LC_RERANK_TOPN=24
RAG_LC_RERANK_ALL=1
# Skip expensive rerank when top score is already confident and candidate set is small.
RAG_LC_RERANK_SKIP_HIGH_CONF=1
RAG_LC_RERANK_SKIP_HIGH_CONF_THRESHOLD=0.18
RAG_LC_RERANK_MIN_DOCS=10
RAG_LC_COMPRESS=1
RAG_LC_COMPRESS_MAX_CHARS=700
RAG_LC_COMPRESS_ALL=1
RAG_LC_ROUTE_LLM=0
RAG_LC_STRUCTURED=0
RAG_LC_ENFORCE_CITATIONS=1
# 0 = skip extra LLM-based citation rewrite in /rag/answer (lower latency)
RAG_CITATION_REPAIR_LLM=0
# Announcements query-only fast-fail: when extractor misses and retrieval confidence is low,
# skip expensive llm_generate and return fallback immediately.
RAG_ANNOUNCEMENTS_FAST_FAIL_QUERY_ONLY=1
RAG_ANNOUNCEMENTS_FAST_FAIL_LOW_SCORE=0.06
RAG_ANNOUNCEMENTS_FAST_FAIL_MIN_CTX=2
# LangChain -> legacy fallback guardrails (avoid duplicate retrieval unless confidence is truly low).
RAG_LC_FALLBACK_MIN_CTX=1
RAG_LC_FALLBACK_LOW_SCORE=0.035

# Fast mode (lower latency, lower recall/precision)
# RAG_USE_LANGCHAIN=1
# RAG_LC_MULTIQUERY=0
# RAG_LC_MULTIQUERY_N=3
# RAG_LC_MULTIQUERY_ALL=0
# RAG_LC_MULTIQUERY_FOR_ANCHORED=0
# RAG_LC_PARALLEL=1
# RAG_LC_PARALLEL_WORKERS=4
# RAG_LC_RERANK=0
# RAG_LC_RERANK_TOPN=24
# RAG_LC_RERANK_ALL=0
# RAG_LC_RERANK_SKIP_HIGH_CONF=1
# RAG_LC_RERANK_SKIP_HIGH_CONF_THRESHOLD=0.18
# RAG_LC_RERANK_MIN_DOCS=10
# RAG_LC_COMPRESS=0
# RAG_LC_COMPRESS_MAX_CHARS=700
# RAG_LC_COMPRESS_ALL=0
# RAG_LC_ROUTE_LLM=0
# RAG_LC_STRUCTURED=0
# RAG_LC_ENFORCE_CITATIONS=0
# RAG_CITATION_REPAIR_LLM=0
# RAG_ANNOUNCEMENTS_FAST_FAIL_QUERY_ONLY=1
# RAG_ANNOUNCEMENTS_FAST_FAIL_LOW_SCORE=0.06
# RAG_ANNOUNCEMENTS_FAST_FAIL_MIN_CTX=2
# RAG_LC_FALLBACK_MIN_CTX=1
# RAG_LC_FALLBACK_LOW_SCORE=0.035

# ------------------------------
# Neo4j (optional)
# ------------------------------
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ------------------------------
# MLflow Tracking
# ------------------------------
# If running in Docker (default): http://mlflow:5000
# If running locally: http://localhost:5000
MLFLOW_TRACKING_URI=http://mlflow:5000

# MLflow Observability
MLFLOW_OBSERVABILITY_ENABLE=1
MLFLOW_OBSERVABILITY_EXPERIMENT=cpe-chat-online-observability
MLFLOW_OBS_FLUSH_S=10
MLFLOW_OBS_WINDOW_N=500

# Log EVERY incoming question as a JSONL artifact (1 line/event)
MLFLOW_OBS_REQUEST_LOG_ENABLE=1
# 1 = store answer + ctx_sources (set 0 to store only question)
MLFLOW_OBS_REQUEST_LOG_CONTENT=1
MLFLOW_OBS_REQUEST_LOG_MAX_CHARS=2000
MLFLOW_OBS_REQUEST_LOG_DIR=requests

# MLflow Tracing (sampled traces)
MLFLOW_TRACING_ENABLE=1
MLFLOW_TRACE_SAMPLE_RATE=0.1
MLFLOW_TRACE_CONTENT=0
MLFLOW_TRACE_MAX_CHARS=1200
