  calculator2023.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\calculator2023.pdf",1,1,1,"owner:unknown",internal,1768655933,"กเกอร์อนุญาตแล้วเท่านั้น
