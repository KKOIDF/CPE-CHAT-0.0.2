chunks[127]{source,path,page,page_start,page_end,owner,sensitivity,updated_at,text,tokens_est,doc_id,file_type,chunk_id,status}:
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",1,1,1,"owner:unknown",internal,1768655933,"ณ สถาบันเทคโนโลยีพระจอมเกล้าธนบุรีตั้งแต่ปีการศึกษา 2540 ดังนี้
ประกาศสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีเรื่องหลักเกณฑ์และวิธีการปฏิบัติเกี่ยวกับการชำระค่าบำรุงและค่าธรรมเนียมการศึกษาพ.ศ. 2540
เพื่ออนุวัติให้เป็นไปตามระเบียบสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีว่าด้วยการกำหนดอัตราค่าบำรุงและค่าธรรมเนียมการศึกษาพ.ศ. 2540 ประกอบกับมติที่ประชุมสภาสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีครั้งที่ 2/2540 วันที่ 27 มีนาคม 2540 สถาบันจึงกำหนดหลักเกณฑ์และวิธีการปฏิบัติเกี่ยวกับค่าบำรุงและค่าธรรมเนียมการศึกษาสำหรับนักศึกษาซึ่งเริ่มหลักสูตรการศึกษาณ สถาบันเทคโนโลยีพระจอมเกล้าธนบุรีตั้งแต่ปีการศึกษา 2540 ดังนี้",148,82cfd9ff20f8467bded96cb437da1766,pdf,0,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",1,1,1,"owner:unknown",internal,1768655933,"งที่งานทะเบียนและสถิตินักศึกษาตามแบบที่สถาบันกำหนด
1. นักศึกษาต้องชำระเงินค่าบำรุงและค่าธรรมเนียมการศึกษาในแต่ละภาคการศึกษาตามอัตราวันเวลาและสถานที่ที่สถาบันกำหนดเมื่อชำระเงินแล้วสถาบันจะไม่คืนเงินให้เว้นแต่กรณีสถาบันประกาศงดการสอนวิชาใดวิชาหนึ่งหรือจำกัดจำนวนนักศึกษาที่ลงทะเบียนในรายวิชาใดวิชาหนึ่งหรือสถาบันประกาศยกเว้นค่าบำรุงและค่าธรรมเนียมการศึกษาให้หากนักศึกษาที่ได้ลงทะเบียนไปแล้วประสงค์จะรับเงินคืนจะต้องยื่นคำร้องที่งานทะเบียนและสถิตินักศึกษาตามแบบที่สถาบันกำหนด",118,0a2575f8c902cdd4fb4baa9283956b67,pdf,1,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",1,1,1,"owner:unknown",internal,1768655933,"ป็นไปตามอัตราของหลักสูตรนั้นๆ
2. นักศึกษาที่ต้องศึกษาปรับพื้นฐานซึ่งเป็นวิชาในระดับปริญญาตรีชำระค่าลงทะเบียนปรับพื้นฐานตามอัตราค่าลงทะเบียนระดับปริญญาตรีส่วนค่าบำรุงและค่าธรรมเนียมการศึกษาและค่าธรรมเนียมเบ็ดเตล็ดของนักศึกษาสูงกว่าปริญญาตรีให้เป็นไปตามอัตราของหลักสูตรนั้นๆ",68,225895d0fa98140509097fb92cf4b7dd,pdf,2,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",1,1,1,"owner:unknown",internal,1768655933,"ารสอนในห้องเรียนแล้วแต่กรณีและชำระค่าบำรุงการศึกษาตามอัตราที่กำหนดในภาคการศึกษานั้นๆ
3. นักศึกษาที่ได้ลงทะเบียนรายวิชาครบหน่วยกิตตามหลักสูตรแล้วแต่ยังทำงานค้นคว้าทดลองสำหรับวิชาโครงงานหรือวิชาวิทยานิพนธ์หรือวิชาการศึกษาพิเศษฯลฯต่อในภาคการศึกษาปกติหรือภาคการศึกษาฤดูร้อนต้องชำระค่าบำรุงและค่าธรรมเนียมการศึกษาดังนี้

3.1 วิชาโครงงาน (Project) วิทยานิพนธ์/ปริญญานิพนธ์ระดับปริญญาตรีวิชาการศึกษาพิเศษ (Special Study) นักศึกษาต้องชำระค่าบำรุงการศึกษาตามอัตราที่กำหนดในภาคการศึกษานั้นๆ
3.2 วิชาวิทยานิพนธ์ (Thesis/Dissertation) การศึกษาปัญหาวิจัย (Research Study) โครงการศึกษาวิจัยการเรียนการสอนในห้องเรียน (Classroom-Based Research Study) นักศึกษาต้องชำระค่าลงทะเบียนวิทยานิพนธ์การศึกษาปัญหาวิจัยการเรียนการสอนในห้องเรียนแล้วแต่กรณีและชำระค่าบำรุงการศึกษาตามอัตราที่กำหนดในภาคการศึกษานั้นๆ",197,5020f6f34b07524068c51c744f0e4e49,pdf,3,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",1,1,1,"owner:unknown",internal,1768655933,"่ไม่ได้ลงทะเบียนเรียน
4. กรณีนักศึกษายังไม่สำเร็จการศึกษาและไม่ได้ลงทะเบียนรายวิชาตามหลักสูตรในภาคการศึกษานั้นๆ ไม่ว่ากรณีใดนักศึกษาต้องชำระค่ารักษาสถานภาพนักศึกษาทุกภาคการศึกษาที่ไม่ได้ลงทะเบียนเรียน",50,21c5c77335f4a1c1960af0997bbea1a0,pdf,4,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",1,1,1,"owner:unknown",internal,1768655933,"่สถาบันจะประกาศงดทำการสอนวิชานั้นๆ
5. การเพิ่มลดหรือถอนรายวิชา

5.1 กรณีที่นักศึกษาขอเพิ่มและลดหรือถอนรายวิชาในเวลาเดียวกันนักศึกษาต้องชำระค่าลงทะเบียนรายวิชาที่ขอเพิ่มจะหักลบกับรายวิชาที่ขอลดหรือถอนไม่ได้
5.2 กรณีนักศึกษาขอลดหรือถอนรายวิชาสถาบันจะไม่คืนเงินค่าลงทะเบียนรายวิชาให้เว้นแต่สถาบันจะประกาศงดทำการสอนวิชานั้นๆ",80,790350dbcfcc02fc794646496eb6045e,pdf,5,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",2,2,2,"owner:unknown",internal,1768655933,"รับตามประกาศสถาบัน
6. การลงทะเบียนรายวิชาวิชาวิทยานิพนธ์วิชาการศึกษาพิเศษฯลฯล่าช้าหรือไม่ดำเนินการรักษาสถานภาพนักศึกษาตามเวลาที่สถาบันกำหนดต้องชำระค่าปรับตามประกาศสถาบัน",43,fe60befae02da20515253af07fb83b70,pdf,6,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",2,2,2,"owner:unknown",internal,1768655933,"ในอัตราค่าบำรุงการศึกษาภาคฤดูร้อน
7. คำลงทะเบียนวิชาวิทยานิพนธ์ (Thesis/Dissertation) การศึกษาปัญหาวิจัย (Research Study) และโครงการศึกษาวิจัยการเรียนการสอนในห้องเรียน (Classroom-Based Research Study) ในภาคการศึกษาฤดูร้อนให้เก็บในอัตราภาคการศึกษาปกติส่วนค่าบำรุงการศึกษาให้เก็บในอัตราค่าบำรุงการศึกษาภาคฤดูร้อน",78,1f41efe061c83dd81fbd7613f205c4fc,pdf,7,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",2,2,2,"owner:unknown",internal,1768655933,"เบียนรายวิชาในภาคการศึกษาปกติ
8. คำลงทะเบียนวิชาการศึกษาพิเศษ (Special Study) หรือวิชาอื่นที่มีลักษณะคล้ายกันซึ่งมิได้ใช้ห้องปฏิบัติการของสถาบันเป็นการเรียนในห้องเรียนวิเคราะห์ทางทฤษฎีหรือไปฝึกงานในโรงงานอุตสาหกรรมให้เก็บในอัตราเดียวกับค่าลงทะเบียนรายวิชาในภาคการศึกษาปกติ",68,fac8eb31aba342b5ac4618ee997fc2fc,pdf,8,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",2,2,2,"owner:unknown",internal,1768655933,"การศึกษาของภาคการศึกษาฤดูร้อนตามระดับและหลักสูตรการศึกษานั้นๆ
9. กรณีนักศึกษาไทยจากมหาวิทยาลัยอื่นๆ ของรัฐซึ่งได้รับอนุญาตให้ลงทะเบียนเรียนบางรายวิชาที่สถาบันต้องชำระค่าบำรุงและค่าธรรมเนียมการศึกษาดังนี้

9.1 ค่าบำรุงการศึกษา

(1) ภาคการศึกษาปกติลงทะเบียนรายวิชาไม่เกิน 6 หน่วยกิตชำระค่าบำรุงการศึกษาถึงหนึ่งของอัตราค่าบำรุงการศึกษาถ้าลงทะเบียนรายวิชาเกิน 6 หน่วยกิตชำระค่าบำรุงการศึกษาเท่ากับอัตราค่าบำรุงการศึกษาตามระดับและหลักสูตรการศึกษานั้นๆ
(2) ภาคการศึกษาฤดูร้อนลงทะเบียนเรียนต้องชำระค่าบำรุงตามอัตราค่าบำรุงการศึกษาของภาคการศึกษาฤดูร้อนตามระดับและหลักสูตรการศึกษานั้นๆ",144,2455540de0a39abc63dfd9e95953e461,pdf,9,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",2,2,2,"owner:unknown",internal,1768655933,"ิชา/สายวิชาตามประกาศปฏิทินการศึกษาของสถาบัน
10. ค่าปรับในการดำเนินการล่าช้ากว่ากำหนด

(1) ลงทะเบียนรายวิชาล่าช้า
(2) ลงทะเบียนวิชาวิทยานิพนธ์/การศึกษาพิเศษ/การศึกษาปัญหาวิจัย/โครงการศึกษาวิจัยการเรียนการสอนในห้องเรียนล่าช้า
(3) ชำระค่ารักษาสถานภาพนักศึกษาล่าช้า
(4) ชำระเงินล่าช้ากว่ากำหนดสถาบันจะเก็บค่าปรับเป็นรายวันโดยนับจากวันสิ้นสุดการลงทะเบียนของแต่ละสาขาวิชา/สายวิชาตามประกาศปฏิทินการศึกษาของสถาบัน",102,fa83eef775c068a0fe056d46bbd2eb25,pdf,10,ok
  131.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\131.pdf",2,2,2,"owner:unknown",internal,1768655933,"11. ในกรณีที่มีปัญหาในทางปฏิบัติให้เสนอรองอธิการบดีฝ่ายวิชาการประกาศณ วันที่ 28 มีนาคมพ.ศ. 2540

หริสสูตะบุตร
(นายหริสสูตะบุตร)
อธิการบดี",35,9334c77dd35a649c1a81e05a15642b64,pdf,11,ok
  137.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\137.pdf",1,1,1,"owner:unknown",internal,1768655933,"ันวาคม 2549 มหาวิทยาลัยจึงประกาศอัตราค่าธรรมเนียมขึ้นทะเบียนปริญญาบัตรและประกาศนียบัตรดังนี้
ประกาศสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีเรื่องอัตราค่าธรรมเนียมขึ้นทะเบียนปริญญาบัตรและประกาศนียบัตรด้วยมหาวิทยาลัยเทคโนโลยีพระจอมเกล้าธนบุรีเห็นสมควรปรับปรุงอัตราค่าธรรมเนียมขึ้นทะเบียนปริญญาบัตรและประกาศนียบัตรให้เหมาะสมกับสภาวะปัจจุบันจึงยกเลิกประกาศสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีเรื่องอัตราค่าธรรมเนียมขึ้นทะเบียนปริญญาและประกาศนียบัตรพ.ศ. 2539 ลงวันที่ 12 กรกฎาคม 2539 และให้ใช้ประกาศนี้แทนอาศัยอำนาจตามความในข้อ 7 แห่งระเบียบสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีว่าด้วยการกำหนดอัตราค่าธรรมเนียมขึ้นทะเบียนปริญญาและประกาศนียบัตรพ.ศ. 2539 ประกอบกับมติที่ประชุมคณะกรรมการประสานงานและคณะกรรมการดำเนินงานการจัดงานพิธีพระราชทานปริญญาบัตร 3 สถาบันประจำปี 2549 ครั้งที่ 5/2549 วันที่ 8 ธันวาคม 2549 มหาวิทยาลัยจึงประกาศอัตราค่าธรรมเนียมขึ้นทะเบียนปริญญาบัตรและประกาศนียบัตรดังนี้",217,4211fa398cfb086461f0720265991640,pdf,12,ok
  137.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\137.pdf",1,1,1,"owner:unknown",internal,1768655933,",500 บาท
1. ค่าธรรมเนียมขึ้นทะเบียนปริญญาบัตรหรือประกาศนียบัตรคนละ 1,500 บาท",19,a7ebdcea48c2db31740121b5f3156b5e,pdf,13,ok
  137.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\137.pdf",1,1,1,"owner:unknown",internal,1768655933,"2. ค่าใบแทนปริญญาบัตรหรือประกาศนียบัตรฉบับละ 1,500 บาททั้งนี้ตั้งแต่วันถัดจากวันประกาศเป็นต้นไปประกาศณ วันที่ 14 กรกฎาคมพ.ศ. 2551

(รศ.ดร.ไกรวุฒิเกียรติโกมล)
อธิการบดีมหาวิทยาลัยเทคโนโลยีพระจอมเกล้าธนบุรี",51,c104a74bb4c6f5d4782448924c8bc137,pdf,14,ok
  139.txt,"C:\Users\KritChaJ\CPE-CHAT-0.0.2\data\announcements\139.pdf",1,1,1,"owner:unknown",internal,1768655933,"ประกาศสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีเรื่องอัตราค่าธรรมเนียมการศึกษาเบ็ดเตล็ดสำหรับนักศึกษาระดับปริญญาตรีและบัณฑิตศึกษาด้วยสถาบันเท็มสมควรปรับอัตราค่าธรรมเนียมการศึกษาเบ็ดเตล็ดให้เหมาะสมกับสภาวะปัจจุบันจึงอาศัยอำนาจตามระเบียบสถาบันเทคโนโลยีพระจอมเกล้าธนบุรีว่าด้วยการกำหนดอัตราค่าบำรุงการศึกษาและค่าธรรมเนียมการศึกษาพ.ศ. 2536 ประกอบกับมติคณะกรรมการวิชาการสถาบันครั้งที่ 7/2539 วันที่ 26 สิงหาคม 2539 สถาบันจึงปรับอัตราค่าธรรมเนียมการศึกษาเบ็ดเตล็ดสำหรับนักศึกษาระดับปริญญาตรีและบัณฑิตศึกษาดังต่อไปนี้
